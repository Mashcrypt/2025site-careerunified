rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isRecruiter() {
      return signedIn() && request.auth.token.recruiter == true;
    }

    function isAdmin() {
      return signedIn()
        && (request.auth.token.admin == true || request.auth.uid in ['X3eReX1WGpQSR1svO4JIBFDqFUJ3']);
    }

    function recruiterSingleJobBillingUnchanged() {
      return request.resource.data.get('singleJobCredits', 0) == resource.data.get('singleJobCredits', 0)
        && request.resource.data.get('pendingSingleJobPack', null) == resource.data.get('pendingSingleJobPack', null)
        && request.resource.data.get('pendingSingleJobPayfastPaymentId', null) == resource.data.get('pendingSingleJobPayfastPaymentId', null)
        && request.resource.data.get('pendingSingleJobCreatedAt', null) == resource.data.get('pendingSingleJobCreatedAt', null)
        && request.resource.data.get('pendingSingleJobLastFailedStatus', null) == resource.data.get('pendingSingleJobLastFailedStatus', null)
        && request.resource.data.get('pendingSingleJobLastFailedAt', null) == resource.data.get('pendingSingleJobLastFailedAt', null)
        && request.resource.data.get('lastSingleJobPaymentRef', null) == resource.data.get('lastSingleJobPaymentRef', null)
        && request.resource.data.get('lastSingleJobPaymentVerifiedAt', null) == resource.data.get('lastSingleJobPaymentVerifiedAt', null);
    }

    function jobPromotionUnchanged() {
      return request.resource.data.get('listingTier', null) == resource.data.get('listingTier', null)
        && request.resource.data.get('badge', null) == resource.data.get('badge', null)
        && request.resource.data.get('sponsoredUntil', null) == resource.data.get('sponsoredUntil', null)
        && request.resource.data.get('singleJobOffer', false) == resource.data.get('singleJobOffer', false);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isRecruiter() || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /saved/{savedId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    match /cvs/{cvId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isRecruiter() || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isRecruiter()
        && request.resource.data.recruiterId == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.get('listingTier', null) == null
        && request.resource.data.get('badge', null) == null
        && request.resource.data.get('sponsoredUntil', null) == null
        && request.resource.data.get('singleJobOffer', false) == false;
      allow update: if isAdmin()
        || (isRecruiter()
          && resource.data.recruiterId == request.auth.uid
          && request.resource.data.recruiterId == request.auth.uid
          && (resource.data.status != 'draft' || request.resource.data.status == 'draft')
          && jobPromotionUnchanged());
      allow delete: if isAdmin()
          || (isRecruiter() && resource.data.recruiterId == request.auth.uid);
    }

    match /applications/{applicationId} {
      allow read: if signedIn()
        && (
          resource.data.candidateId == request.auth.uid
          || (isRecruiter() && resource.data.recruiterId == request.auth.uid)
          || isAdmin()
        );
      allow create, update, delete: if isAdmin();
    }

    match /applicationNotes/{applicationId} {
      allow read: if signedIn()
        && (
          (isRecruiter() && resource.data.recruiterId == request.auth.uid)
          || isAdmin()
        );
      allow create, update, delete: if isAdmin();
    }

    match /recruiters/{recruiterId} {
      allow read: if isOwner(recruiterId) || isAdmin();
      allow create: if (isOwner(recruiterId)
          && isRecruiter()
          && request.resource.data.get('singleJobCredits', 0) == 0
          && request.resource.data.get('pendingSingleJobPack', null) == null
          && request.resource.data.get('pendingSingleJobPayfastPaymentId', null) == null
          && request.resource.data.get('pendingSingleJobCreatedAt', null) == null
          && request.resource.data.get('pendingSingleJobLastFailedStatus', null) == null
          && request.resource.data.get('pendingSingleJobLastFailedAt', null) == null
          && request.resource.data.get('lastSingleJobPaymentRef', null) == null
          && request.resource.data.get('lastSingleJobPaymentVerifiedAt', null) == null)
        || isAdmin();
      allow update: if (isOwner(recruiterId)
          && isRecruiter()
          && recruiterSingleJobBillingUnchanged())
        || isAdmin();
      allow delete: if isAdmin();

      match /pipeline/{candidateId} {
        allow read: if (isOwner(recruiterId) && isRecruiter()) || isAdmin();
        allow create, update: if isAdmin()
          || (isOwner(recruiterId)
            && isRecruiter()
            && request.resource.data.recruiterId == recruiterId
            && request.resource.data.candidateId == candidateId
            && request.resource.data.stage in ['new', 'contacted', 'interview', 'offer', 'hired', 'rejected']
            && request.resource.data.favorite is bool
            && request.resource.data.notes is list
            && request.resource.data.notes.size() <= 20);
        allow delete: if (isOwner(recruiterId) && isRecruiter()) || isAdmin();
      }
    }

    match /recruiterApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    match /payfastPayments/{paymentId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if isAdmin();
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /interviewQuestions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
